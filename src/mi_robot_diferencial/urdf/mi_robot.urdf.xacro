<?xml version="1.0"?>
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="rueda_radio" value="0.05"/>
  <xacro:property name="rueda_ancho" value="0.03"/>
  <xacro:property name="separacion_ruedas" value="0.23"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <xacro:macro name="rueda" params="prefijo y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>
    </link>

    <joint name="joint_rueda_${prefijo}" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <!-- rpy = -π/2: el eje z de la rueda queda apuntando a +y, así ω > 0 hace avanzar al robot en +x -->
      <origin xyz="0 ${y_signo * separacion_ruedas/2} -0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:rueda prefijo="izq" y_signo="1"/>
  <xacro:rueda prefijo="der" y_signo="-1"/>

  <!-- Apoyos (caster) adelante y atrás: sin ellos el robot se inclina y
       arrastra la caja contra el piso, lo que perturba el control. -->
  <xacro:property name="caster_radio" value="0.01"/>
  <xacro:macro name="caster" params="prefijo x">
    <link name="caster_${prefijo}">
      <collision>
        <geometry><sphere radius="${caster_radio}"/></geometry>
      </collision>
      <visual>
        <geometry><sphere radius="${caster_radio}"/></geometry>
        <material name="gris"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="joint_caster_${prefijo}" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefijo}"/>
      <!-- z: el fondo de la esfera queda a la altura del fondo de las ruedas -->
      <origin xyz="${x} 0 ${-0.02 - rueda_radio + caster_radio}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="caster_${prefijo}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster prefijo="del" x="0.12"/>
  <xacro:caster prefijo="tra" x="-0.12"/>

  <gazebo>
    <!-- El plugin DiffDrive hace internamente la cinemática inversa ω = W⁺ξ (ec. 22) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_rueda_izq</left_joint>
      <right_joint>joint_rueda_der</right_joint>
      <wheel_separation>${separacion_ruedas}</wheel_separation>
      <wheel_radius>${rueda_radio}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <!-- Publica el estado de las ruedas (para que RViz las dibuje girando) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

    <!-- =================== LiDAR =================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/> <!-- Un cilindro pequeño -->
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
    <!-- Inercia mínima obligatoria para Gazebo -->
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/> <!-- Asumo que tu chasis principal se llama base_link -->
    <child link="lidar_link"/>
    <!-- Ajusta la 'z' para que quede sobre el techo de tu cajita azul -->
    <!-- xyz: Adelante/Atras(x), Izquierda/Derecha(y), Arriba/Abajo(z) -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/> 
  </joint>

  <!-- =================== CÁMARA =================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.03"/> <!-- Una cajita rectangular -->
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <!-- Ajusta la 'x' para que quede en el frente del robot -->
    <origin xyz="0.16 0 0" rpy="0 0 0"/> 
    <child link="camera_link"/>
  </joint>

    <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize> <!-- Verás los rayos azules en Gazebo -->
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <!-- Rango: 360 grados (-PI a PI). Resolución justificada para el Notion -->
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.015000</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate> <!-- 30 FPS como pide el taller -->
      <topic>image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov> <!-- ~60 grados FOV -->
        <image>
          <width>640</width> <!-- Resolución 640x480 -->
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>    
</robot>